# Backend / ML service
backend/.env
backend/dist
ml-service/__pycache__/
ml-service/*.pkl
# ...except the real trained model — Render/Railway/etc. build from git, so
# if this stayed ignored, a git-based deploy would silently ship an
# ml-service with no model file at all. It's ~10MB, well under GitHub's
# 100MB per-file limit.
!ml-service/career_xgboost_model.pkl
ml-service/.venv

