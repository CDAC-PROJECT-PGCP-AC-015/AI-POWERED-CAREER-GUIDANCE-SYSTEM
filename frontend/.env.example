# Frontend -> backend wiring (see server/README.md to run the backend)
VITE_API_URL=http://localhost:5001/api

# --- Server-only env vars (read in src/lib/career-engine.server.ts) ---
# These power the LLM interview + AI summaries + ML feature extraction, and
# the ML model call that the frontend's assessment flow uses directly. See
# that file's top comment for full details, or the root README for a walkthrough.

# Your XGBoost model, served by ml-service/ (see ml-service/README.md)
CAREER_MODEL_URL=http://localhost:8000/predict
CAREER_MODEL_KEY=

# The backend's own API base URL — needed so career-engine.server.ts can
# fetch the real mentor directory (for AI-picked mentors) and, when
# TAVILY_API_KEY is set on the backend, real live courses/companies.
BACKEND_API_URL=http://localhost:5001/api

# --- Primary LLM: OpenRouter (https://openrouter.ai/keys) ---
# Powers the conversational assessment, AI-written career summaries, and the
# structured feature extraction that feeds the ML model. Leave LLM_API_KEY
# blank to run with built-in template text instead (no LLM features).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# --- Secondary LLM: Groq (https://console.groq.com) ---
# Used automatically ONLY when the primary (OpenRouter) call errors, times
# out, or returns a non-2xx response — e.g. during an OpenRouter outage.
# Optional, but recommended: Groq is fast/cheap and makes the whole LLM
# layer resilient to a single provider having a bad day.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
