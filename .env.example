# Copy this file to ".env" in this same folder.
#
# For LOCAL DEV (docker-compose.yml): only the LLM/Tavily keys near the
# bottom matter, and all are optional — the app works without them, just
# with fallback behavior (see comments below).
#
# For PRODUCTION (docker-compose.prod.yml): every REQUIRED value below must
# be set or `docker compose up` will refuse to start (that's intentional —
# see DEPLOY.md). Note DEPLOY_FREE.md (Render/Neon/Cloudflare, no Docker) is
# a separate path with its own env var setup per-service — see that guide.

# --- Required for docker-compose.prod.yml ---

# The domain pointing at this server (A record already set up in your DNS).
# Caddy uses this to request a real HTTPS certificate automatically.
DOMAIN=

# Long random string — used to sign login tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Real Postgres password for production (the docker-compose.yml dev default,
# "career_pass", is fine for local dev but should never be used publicly).
POSTGRES_PASSWORD=

# --- Optional, both dev and prod ---
# These are read by the FRONTEND service (frontend/src/lib/career-engine.server.ts),
# not the backend — see docker-compose.prod.yml's `frontend` service env block.

# Primary LLM — OpenRouter (https://openrouter.ai/keys). Powers the conversational
# assessment, AI-written career summaries, and the structured feature extraction
# that feeds the ML model. Without it, built-in template text is used instead.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Secondary LLM — Groq (https://console.groq.com). Used automatically ONLY if
# the primary (OpenRouter) call errors, times out, or returns a non-2xx
# response. Optional, but recommended since OpenRouter occasionally has
# availability hiccups and Groq is fast/cheap as a backup.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Optional, backend service ---

# Tavily web search (https://tavily.com, free tier available) — powers the
# "Live openings" links on Dashboard / Career Guidance company cards with
# REAL, currently-indexed job postings, plus live course and live-hiring-
# company discovery (GET /api/discover/courses, /api/discover/companies).
# Without it, those fall back to job-board/course-provider SEARCH pages
# instead of specific live results.
TAVILY_API_KEY=
