# PostgreSQL connection — matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://career_admin:career_pass@localhost:5432/career_guidance?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="24h"

# Where the FastAPI ML microservice (../ml-service) is running
CAREER_MODEL_URL="http://localhost:8000/predict"
CAREER_MODEL_KEY=""

# Tavily web search (https://tavily.com) — used to fetch REAL, currently-live
# results for three features: job postings ("current openings" links on
# Dashboard/Career Guidance), live courses (/api/discover/courses), and
# companies currently hiring (/api/discover/companies). Optional: without
# it, those fall back to generic job-board/course-provider search pages
# instead of specific live results.
TAVILY_API_KEY=""

# NOTE: the LLM keys (LLM_API_KEY / LLM_FALLBACK_API_KEY etc.) are NOT read
# here — the LLM calls happen in frontend/src/lib/career-engine.server.ts,
# a server-only function inside the frontend app. Set those in
# frontend/.env instead (see frontend/.env.example).

PORT=5001
CORS_ORIGIN="http://localhost:3000"
